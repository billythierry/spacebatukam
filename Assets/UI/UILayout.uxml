<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Label text="Score : 0" name="ScoreLabel" style="align-items: auto; align-self: center; font-size: 20px; color: rgb(255, 255, 255); -unity-font-style: bold; -unity-text-align: upper-center;"/>
    <ui:Button text="Restart" name="RestartButton" style="position: absolute; top: 50%; align-items: stretch; align-self: center; -unity-font-style: bold; font-size: 20px; background-color: rgba(188, 188, 188, 0); color: rgb(255, 255, 255); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255);"/>
    <ui:Button text="Back to Menu" name="BackToMenuButton" style="position: absolute; top: 67%; align-items: stretch; align-self: center; -unity-font-style: bold; font-size: 20px; background-color: rgba(188, 188, 188, 0); color: rgb(255, 255, 255); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255);"/>
    <ui:Button text="Resume" name="ResumeButton" style="position: absolute; top: 50%; align-items: stretch; align-self: center; -unity-font-style: bold; font-size: 20px; background-color: rgba(188, 188, 188, 0); color: rgb(255, 255, 255); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255);"/>
</ui:UXML>
